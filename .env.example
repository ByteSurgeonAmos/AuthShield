HOST=localhost
PORT=3000
DB_TYPE=postgres
DATABASE=xmobit_auth
USERNAME=postgres
PASS=your_database_password
SSL=false
DATABASE_URL=postgresql://username:password@localhost:5432/xmobit_auth

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here

# Email Configuration (Nodemailer - replaces Postmark)
EMAIL_HOST=mail.privateemail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=no.reply@xmobit.com
EMAIL_PASS=your_email_password_here

# Optional: Custom notification email (defaults to EMAIL_USER)
NOTIFICATIONS_EMAIL=no.reply@xmobit.com

# Application URLs
BASE_URL=http://localhost:3001

# SMS Configuration
AT_USERNAME=your_africastalking_username
AT_KEY=your_africastalking_api_key
TIARA_API_TOKEN=your_tiara_api_token_here
SMS_SENDER_ID=xmobit

# API KEY FOR SERVICE-TO-SERVICE AUTHENTICATION
API_KEY=your_secure_api_key_here

# HMAC Secret for wallet creation
HMAC_SECRET=your-hmac-secret-for-wallet-signing

# Wallet API Configuration
BTC_WALLET_API_URL=http://localhost:3002
BTC_API_TOKEN=your_btc_api_token
MONERO_WALLET_API_URL=http://localhost:3003
XMR_API_TOKEN=your_xmr_api_token

# Environment
NODE_ENV=development

# Legacy configuration (can be removed)
# POSTMARK_SERVER_TOKEN=your_postmark_token